# ─────────────────────────────────────────────────────────────
# Copiá este archivo como .env (desarrollo) y cargá las mismas
# variables en Vercel → Project → Settings → Environment Variables.
# Ninguna de estas variables es secreta: todas terminan en el
# bundle público del navegador (prefijo VITE_).
# ─────────────────────────────────────────────────────────────

# URL pública final del sitio, sin barra al final.
# Se usa para canonical, Open Graph, sitemap.xml y robots.txt.
VITE_SITE_URL=https://www.tudominio.com.ar

# Número de WhatsApp en formato internacional, SOLO dígitos,
# sin +, espacios ni guiones. Argentina móvil: 549 + área + número.
# Ejemplo de formato (no es un número real): 5493510000000
VITE_WHATSAPP_NUMBER=

# Email de contacto que se muestra en el sitio.
VITE_CONTACT_EMAIL=

# Access key de Web3Forms (https://web3forms.com). Es pública por
# diseño: identifica a qué email se envían las consultas.
VITE_WEB3FORMS_ACCESS_KEY=

# Google Analytics 4 (formato G-XXXXXXXXXX). Opcional.
VITE_GA_ID=

# Google Tag Manager (formato GTM-XXXXXXX). Opcional.
# Si usás GTM, configurá GA4 dentro de GTM y dejá VITE_GA_ID vacío
# para no contar las visitas dos veces.
VITE_GTM_ID=
